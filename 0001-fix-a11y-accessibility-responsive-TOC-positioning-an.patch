+/* ── Floating Table of Contents ─────────────────────────────────── */
+.floating-toc {
+    --toc-collapsed-width: 2.75rem;
+    position: fixed;
+    top: 50%;
+    right: min(2rem, max(1rem, calc(50vw - 28rem)));
+    z-index: 50;
+    display: none;
+    width: var(--toc-collapsed-width);
+    max-width: calc(100vw - 2rem);
+    transform: translateY(-50%);
+}
+
+.floating-toc[hidden] {
+    display: none !important;
+}
+
+.floating-toc__box {
+    width: 100%;
+    max-height: min(75vh, 42rem);
+    overflow: hidden;
+    border: 1px solid transparent;
+    border-radius: 0.9rem;
+    background: transparent;
+    color: #9ca3af;
+    transition:
+        width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        background-color 0.25s ease,
+        border-color 0.25s ease,
+        box-shadow 0.25s ease;
+}
+
+.floating-toc__toggle {
+    display: flex;
+    width: 100%;
+    min-height: 2.75rem;
+    align-items: center;
+    gap: 0.65rem;
+    border: 0;
+    border-radius: 0.8rem;
+    padding: 0.65rem 0.75rem;
+    background: rgba(17, 24, 39, 0.72);
+    color: inherit;
+    cursor: pointer;
+    font: inherit;
+    text-align: left;
+    -webkit-tap-highlight-color: transparent;
+}
+
+.floating-toc__toggle:focus-visible,
+.toc-item:focus-visible {
+    outline: 2px solid rgb(103, 232, 249);
+    outline-offset: 2px;
+}
+
+.floating-toc__toggle-icon,
+.floating-toc__toggle-icon::before,
+.floating-toc__toggle-icon::after {
+    display: block;
+    width: 1.25rem;
+    height: 2px;
+    border-radius: 999px;
+    background: currentColor;
+}
+
+.floating-toc__toggle-icon {
+    position: relative;
+    flex: 0 0 auto;
+}
+
+.floating-toc__toggle-icon::before,
+.floating-toc__toggle-icon::after {
+    position: absolute;
+    right: 0;
+    content: "";
+}
+
+.floating-toc__toggle-icon::before {
+    top: -0.38rem;
+    width: 0.8rem;
+}
+
+.floating-toc__toggle-icon::after {
+    top: 0.38rem;
+    width: 1rem;
+}
+
+.floating-toc__toggle-text {
+    overflow: hidden;
+    opacity: 0;
+    white-space: nowrap;
+    transition: opacity 0.15s ease;
+}
+
+.floating-toc__nav {
+    display: none;
+    max-height: calc(min(75vh, 42rem) - 3.5rem);
+    overflow-x: hidden;
+    overflow-y: auto;
+    padding: 0.25rem 0.4rem 0.6rem;
+    scrollbar-color: rgba(103, 232, 249, 0.45) rgba(31, 41, 55, 0.55);
+    scrollbar-width: thin;
+    overscroll-behavior: contain;
+}
+
+.floating-toc__nav::-webkit-scrollbar {
+    width: 5px;
+}
+
+.floating-toc__nav::-webkit-scrollbar-track {
+    background: rgba(31, 41, 55, 0.4);
+    border-radius: 999px;
+}
+
+.floating-toc__nav::-webkit-scrollbar-thumb {
+    background: rgba(103, 232, 249, 0.45);
+    border-radius: 999px;
+}
+
+.floating-toc__nav::-webkit-scrollbar-thumb:hover {
+    background: rgba(103, 232, 249, 0.75);
+}
+
+.toc-item {
+    position: relative;
+    display: flex;
+    min-height: 1.9rem;
+    align-items: center;
+    border-left: 2px solid transparent;
+    border-radius: 0 0.5rem 0.5rem 0;
+    padding: 0.3rem 0.5rem 0.3rem 0.6rem;
+    color: #9ca3af;
+    font-size: 0.8125rem;
+    line-height: 1.25;
+    text-decoration: none;
+    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
+}
+
+.toc-item--nested {
+    padding-left: 1.35rem;
+    font-size: 0.75rem;
+}
+
+.toc-item:hover,
+.toc-item:focus-visible {
+    background: rgba(255, 255, 255, 0.1);
+    color: #fff;
+}
+
+.toc-item.is-active,
+.toc-item[aria-current="location"] {
+    border-left-color: rgb(103, 232, 249);
+    background: rgba(103, 232, 249, 0.08);
+    color: rgb(103, 232, 249);
+    font-weight: 600;
+}
+
+.floating-toc.is-expanded {
+    width: min(20rem, calc(100vw - 2rem));
+}
+
+.floating-toc.is-expanded .floating-toc__box {
+    border-color: rgb(31, 41, 55);
+    background: rgba(17, 24, 39, 0.96);
+    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
+    backdrop-filter: blur(18px);
+}
+
+.floating-toc.is-expanded .floating-toc__toggle {
+    background: transparent;
+    color: #e5e7eb;
+}
+
+.floating-toc.is-expanded .floating-toc__toggle-text {
+    opacity: 1;
+}
+
+.floating-toc.is-expanded .floating-toc__nav {
+    display: block;
+}
+
+@media (hover: hover) and (pointer: fine) {
+    .floating-toc:hover,
+    .floating-toc:focus-within {
+        width: min(20rem, calc(100vw - 2rem));
+    }
+
+    .floating-toc:hover .floating-toc__box,
+    .floating-toc:focus-within .floating-toc__box {
+        border-color: rgb(31, 41, 55);
+        background: rgba(17, 24, 39, 0.96);
+        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
+        backdrop-filter: blur(18px);
+    }
+
+    .floating-toc:hover .floating-toc__toggle,
+    .floating-toc:focus-within .floating-toc__toggle {
+        background: transparent;
+        color: #e5e7eb;
+    }
+
+    .floating-toc:hover .floating-toc__toggle-text,
+    .floating-toc:focus-within .floating-toc__toggle-text {
+        opacity: 1;
+    }
+
+    .floating-toc:hover .floating-toc__nav,
+    .floating-toc:focus-within .floating-toc__nav {
+        display: block;
+    }
+}
+
+/* Show floating TOC only on viewports wide enough to avoid overlapping main article text. */
+@media (min-width: 82rem) {
+    .floating-toc {
+        display: block;
+    }
+}
+
+.blog-content h2[id],
+.blog-content h3[id] {
+    scroll-margin-top: 5rem;
+}
+
+.blog-content h2[id]:focus,
+.blog-content h3[id]:focus {
+    outline: 2px solid rgb(103, 232, 249);
+    outline-offset: 0.3rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    html {
+        scroll-behavior: auto !important;
+    }
+
+    #reading-progress-bar,
+    .floating-toc,
+    .floating-toc__box,
+    .floating-toc__toggle-text,
+    .toc-item {
+        transition-duration: 0.01ms !important;
+        animation-duration: 0.01ms !important;
+    }
+
+    .lazy-iframe-ph {
+        animation: none;
+    }
+}
